{
  "name": "@zwicker-software/copilot-paperclip-adapter",
  "version": "0.3.0",
  "description": "Paperclip external adapter (type copilot_local) that runs the GitHub Copilot CLI. Zwicker Software fork of @superbiche/copilot-paperclip-adapter 0.2.1 with the full Paperclip run contract: wake payload, run API key, managed instructions, runtime tools / MCP, cooperative cancel, usage file. Original work by tjp2021, HearthCore and superbiche (MIT).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/zwick/paperclip-adapters/tree/main/packages/copilot-local#readme",
  "bugs": {
    "url": "https://github.com/zwick/paperclip-adapters/issues"
  },
  "keywords": [
    "paperclip",
    "paperclipai",
    "adapter",
    "copilot",
    "github-copilot",
    "agent",
    "ai",
    "coding-agent",
    "llm",
    "orchestration"
  ],
  "author": "tjp2021 (https://github.com/tjp2021)",
  "contributors": [
    "HearthCore (https://github.com/HearthCore)",
    "Michel Tomas <michel@tsbwc.com> (https://github.com/superbiche)",
    "Zwicker Software (fork maintainers)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zwick/paperclip-adapters",
    "directory": "packages/copilot-local"
  },
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./ui-parser": "./dist/ui-parser.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "2026.1005.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
